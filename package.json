{
  "name": "cesium-annotation-editor",
  "version": "0.1.0",
  "description": "A TypeScript Cesium annotation drawing and editing plugin.",
  "type": "module",
  "author": "nanvon <nanvon@foxmail.com>",
  "homepage": "https://github.com/nanvon/cesium-annotation-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanvon/cesium-annotation-editor.git"
  },
  "bugs": {
    "url": "https://github.com/nanvon/cesium-annotation-editor/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "docs/cesium-annotation-editor"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "vite --host 0.0.0.0",
    "demo": "vite --host 0.0.0.0"
  },
  "peerDependencies": {
    "cesium": "^1.130.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "cesium": "^1.130.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-cesium": "^1.2.23",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^4.1.7"
  },
  "keywords": [
    "cesium",
    "annotation",
    "drawing",
    "editor",
    "typescript"
  ],
  "license": "MIT"
}
